# PostgreSQL started by `pnpm db:up` (host port 5433 avoids a local Postgres on 5432).
DATABASE_URL=postgres://warewolf:warewolf@localhost:5433/warewolf

# API
PORT=3000
# Origins allowed to call the API from elsewhere, comma separated, exact (WW-1602). Empty: same origin only.
# The Android APK is https://localhost, or http://localhost in a LAN debug build (VITE_API_ORIGIN=http://...).
# CORS_ORIGINS=https://localhost

# Web client: API origin for builds that do not share an origin with the API, such as the Android APK.
# VITE_API_ORIGIN=https://api.example.com
