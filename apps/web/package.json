{
  "name": "@warewolf/web",
  "version": "0.0.0",
  "private": true,
  "description": "React client. Renders server projections. One layout for desktop and landscape, reflowed for portrait.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "android:sync": "pnpm build && cap sync android",
    "android:apk": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@warewolf/contracts": "workspace:^",
    "@warewolf/domain": "workspace:^",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@warewolf/e2e-tools": "workspace:^",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vite-imagetools": "^12.0.1"
  }
}
