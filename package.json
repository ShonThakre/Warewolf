{
  "name": "warewolf",
  "private": true,
  "description": "Werewolf multiplayer game: domain rules, API, and web client.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @warewolf/api test:integration",
    "e2e:api": "pnpm --filter @warewolf/api e2e",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @warewolf/api db:migrate",
    "db:rollback": "pnpm --filter @warewolf/api db:rollback",
    "dev:api": "pnpm --filter @warewolf/api dev",
    "dev:web": "pnpm --filter @warewolf/web dev",
    "art:check": "pnpm --filter @warewolf/art-tools check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
